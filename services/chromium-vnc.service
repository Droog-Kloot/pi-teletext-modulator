[Unit]
Description=Pi Teletext Modulator - VNC for virtual X11 display
Requires=virtual-display.service
After=virtual-display.service

[Service]
Type=simple
User=__USER__
Environment=DISPLAY=:99
Environment=HOME=__HOME__
ExecStartPre=/bin/sh -c 'until /usr/bin/xdpyinfo -display :99 >/dev/null 2>&1; do sleep 1; done'
ExecStart=/usr/bin/x11vnc -display :99 -localhost -forever -shared -nopw -rfbport 5900 -quiet
Restart=on-failure
RestartSec=4

[Install]
WantedBy=multi-user.target
