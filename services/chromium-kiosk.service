[Unit]
Description=Pi Teletext Modulator - Chromium kiosk on Xvfb
Requires=virtual-display.service
After=virtual-display.service

[Service]
Type=simple
User=__USER__
Environment=DISPLAY=:99
Environment=HOME=__HOME__
ExecStartPre=/bin/sh -c 'until /usr/bin/xdpyinfo -display :99 >/dev/null 2>&1; do sleep 1; done'
ExecStart=/usr/bin/chromium --no-first-run --no-default-browser-check --disable-gpu --disable-dev-shm-usage --kiosk https://schatkamer.beeldengeluid.nl/
Restart=on-failure
RestartSec=4

[Install]
WantedBy=multi-user.target
